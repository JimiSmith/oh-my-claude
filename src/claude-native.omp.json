{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": false,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "powerline",
          "foreground": "p:gray",
          "background": "p:blue",
          "template": " \uea83 {{ .Path }} ",
          "powerline_symbol": "\ue0b0",
          "leading_powerline_symbol": "\ue0b6",
          "options": {
            "folder_icon": " \uf07b ",
            "home_icon": "\ue617",
            "style": "folder"
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "foreground": "p:blue",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:gray{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:gray{{ end }}",
            "{{ if gt .Ahead 0 }}p:gray{{ end }}",
            "{{ if gt .Behind 0 }}p:gray{{ end }}"
          ],
          "background": "p:gray",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:dirty{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:diverged{{ end }}",
            "{{ if gt .Ahead 0 }}p:ahead{{ end }}",
            "{{ if gt .Behind 0 }}p:behind{{ end }}"
          ],
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "claude",
          "style": "powerline",
          "foreground": "p:lime",
          "background": "p:teal",
          "leading_powerline_symbol": "\ue0b6",
          "powerline_symbol": "\ue0b0",
          "template": " \udb82\udfc9 {{ .Model.DisplayName }} "
        },
        {
          "type": "claude",
          "style": "powerline",
          "foreground": "p:teal",
          "background": "p:lime",
          "powerline_symbol": "\ue0b0",
          "template": "{{ if .ContextWindow.ContextWindowSize }} \udb80\udf5b ctx {{ .TokenUsagePercent }}% {{ end }}"
        },
        {
          "type": "claude",
          "style": "powerline",
          "foreground": "p:lime",
          "background": "p:teal",
          "powerline_symbol": "\ue0b0",
          "background_templates": [
            "{{ if gt .FiveHourUsage 90.0 }}p:warning{{ end }}"
          ],
          "template": "{{ if not .FiveHourResetsAt.IsZero }} \udb81\udd1b 5h {{ .FiveHourUsage }}% \u00b7 {{ regexReplaceAll \"m[0-9.]+s$\" (printf \"%v\" .FiveHourResetsIn) \"min\" }} {{ end }}"
        },
        {
          "type": "claude",
          "style": "powerline",
          "foreground": "p:teal",
          "background": "p:lime",
          "powerline_symbol": "\ue0b0",
          "background_templates": [
            "{{ if gt .SevenDayUsage 90.0 }}p:warning{{ end }}"
          ],
          "template": "{{ if not .SevenDayResetsAt.IsZero }} \udb81\udcc5 7d {{ .SevenDayUsage }}% \u00b7 {{ .SevenDayResetsAt.Format \"Mon 15:04\" }} {{ end }}"
        }
      ]
    }
  ],
  "palette": {
    "teal": "#003543",
    "blue": "#0087d8",
    "lime": "#d2ff5e",
    "orange": "#f36943",
    "gray": "#242424",
    "dirty": "#ff9248",
    "ahead": "#89d1dc",
    "behind": "#f17c37",
    "diverged": "#f26d50",
    "warning": "#ff8d0a"
  }
}
