{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": false,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "powerline",
          "foreground": "p:gray",
          "background": "p:blue",
          "template": " \uea83 {{ .Path }} ",
          "powerline_symbol": "\ue0b0",
          "leading_powerline_symbol": "\ue0b6",
          "options": {
            "folder_icon": " \uf07b ",
            "home_icon": "\ue617",
            "style": "folder"
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "foreground": "p:blue",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:gray{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:gray{{ end }}",
            "{{ if gt .Ahead 0 }}p:gray{{ end }}"
          ],
          "background": "p:gray",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:dirty{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:diverged{{ end }}",
            "{{ if gt .Ahead 0 }}p:ahead{{ end }}",
            "{{ if gt .Behind 0 }}p:behind{{ end }}"
          ],
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "diamond",
          "foreground": "p:lime",
          "background": "p:teal",
          "template": " \udb82\udfc9 {{ .Env.CLAUDE_MODEL }} ",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": ""
        },
        {
          "type": "text",
          "style": "powerline",
          "foreground": "p:teal",
          "background": "p:lime",
          "template": "{{ if .Env.CLAUDE_CONTEXT }} \udb80\udf5b ctx {{ .Env.CLAUDE_CONTEXT }} {{ end }}",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "text",
          "style": "powerline",
          "foreground": "p:lime",
          "background": "p:teal",
          "background_templates": [
            "{{ if gt (atoi (trimSuffix \"%\" (first (splitList \" \" .Env.CLAUDE_5H)))) 90 }}p:warning{{ end }}"
          ],
          "template": "{{ if .Env.CLAUDE_5H }} \udb81\udd1b 5h {{ .Env.CLAUDE_5H }} {{ end }}",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "text",
          "style": "powerline",
          "foreground": "p:teal",
          "background": "p:lime",
          "background_templates": [
            "{{ if gt (atoi (trimSuffix \"%\" (first (splitList \" \" .Env.CLAUDE_7D)))) 90 }}p:warning{{ end }}"
          ],
          "template": "{{ if .Env.CLAUDE_7D }} \udb81\udcc5 7d {{ .Env.CLAUDE_7D }} {{ end }}",
          "powerline_symbol": "\ue0b0"
        }
      ]
    }
  ],
  "palette": {
    "teal": "#003543",
    "blue": "#0087d8",
    "lime": "#d2ff5e",
    "orange": "#f36943",
    "gray": "#242424",
    "dirty": "#ff9248",
    "ahead": "#89d1dc",
    "behind": "#f17c37",
    "diverged": "#f26d50",
    "warning": "#ff8d0a"
  }
}